# Secrets - never commit
.env

# The private Python box - rebuilt by start-windows.bat
.venv/

# The local database - it holds data, not code
*.sqlite3
*.sqlite3-journal

# Uploaded files (photos come in Lesson 7)
media/
private_uploads/

# Python leftovers
__pycache__/
*.pyc

# Backups we make before changing files
*.bak
backups/

# Editors and Windows
.vscode/
.idea/
Thumbs.db
desktop.ini

# Collected static files (made by `manage.py collectstatic`, never edited by hand)
staticfiles/
