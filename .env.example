# Copy of the settings the server needs. The real values go in .env
# (which git ignores). start-windows.bat creates .env from this file
# the first time and adds a fresh DJANGO_SECRET_KEY line at the end.

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave empty to use SQLite (db.sqlite3). Fill in to use PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# WhatsApp codes: "test" prints them in the server window. "live" needs a Meta account (costs money).
WHATSAPP_MODE=test
